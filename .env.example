# =========================================================
# BACKEND UNIQUEMENT (Render / Koyeb / Serveur Node.js)
# NE JAMAIS METTRE CES CLÉS DANS LE FRONTEND OU SUR GITHUB
# =========================================================
# GEMINI_API_KEY: Clé secrète Google Gemini utilisée uniquement côté serveur (server.ts).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ALLOWED_ORIGINS: Origines autorisées pour CORS (ex: https://votre-pseudo.github.io)
ALLOWED_ORIGINS=""

# APP_URL: URL publique du serveur (injectée automatiquement sur Cloud Run / AI Studio).
APP_URL="MY_APP_URL"

# =========================================================
# FRONTEND UNIQUEMENT (Build Vite / GitHub Pages Variable)
# =========================================================
# VITE_API_BASE_URL: URL publique de votre backend séparé (ex: https://mon-histoire-api.onrender.com).
# Ce n'est PAS une clé secrète. Laissez vide pour utiliser le moteur local autonome sur GitHub Pages.
VITE_API_BASE_URL=""
